{
  "name": "smart-garage-pages",
  "version": "1.0.0",
  "description": "Cloudflare Pages implementation of Smart Garage Controller",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB",
    "deploy": "wrangler pages deploy public --project-name=garage-onyachamp --branch=production",
    "pin": "node scripts/change-pin.mjs",
    "db:init": "wrangler d1 execute garage-db --local --file=./schema.sql",
    "db:init-remote": "wrangler d1 execute garage-db --remote --file=./schema.sql",
    "test": "node tests/stats-auth.test.mjs && node tests/pin-length.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
