# Garage Access Portal Configuration
# Set the 4-digit PIN for standard user access
GARAGE_PIN=1234

# Admin PIN to view and whitelist devices in the WebUI
GARAGE_ADMIN_PIN=0000

# Broadlink RM4 Pro Network Details (Auto-populated via python discover.py)
BROADLINK_IP=192.168.1.50
BROADLINK_MAC=34:ea:34:xx:xx:xx

# Optional service token if using standalone garage_rf_service.py
SERVICE_TOKEN=your-secure-service-token-here

# Local Web Server Port
PORT=8000
